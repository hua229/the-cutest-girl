<?xml version="1.0" encoding="utf-8"?>
<!-- FIX-02：Android 12+ 备份/换机迁移，只排除密码与账本，身份可迁移 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="dav_secret.xml" />
        <exclude domain="sharedpref" path="sync_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="dav_secret.xml" />
        <exclude domain="sharedpref" path="sync_state.xml" />
    </device-transfer>
</data-extraction-rules>